# HTTP-Cache und Laufzeitartefakte
.cache/
run.log
audit.log

# Generierte Ausgaben - entstehen bei jedem Lauf neu
bericht.html
deals.json

# Versioniert wird der Preisverlauf als historie/*.jsonl.xz — eine Datei je
# Lauftag, die sich nie wieder ändert. preise.db ist daraus nur ein abgeleiteter
# SQLite-Index und wird bei Bedarf neu aufgebaut; sie täglich zu committen
# hätte nach einem Jahr mehrere Gigabyte Git-Historie erzeugt.
preise.db

# Bewertungs-Cache (wird wöchentlich neu geholt). Die manuell gepflegte
# Variante ist dagegen bewusst nicht ignoriert - siehe .beispiel.json.
bewertungen.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
